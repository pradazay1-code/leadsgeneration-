# ---------------------------------------------------------------------------
# LeadSignal configuration
#
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead.
# ---------------------------------------------------------------------------

# REQUIRED for real lead discovery.
# Google Places API (New). Enable "Places API (New)" in a Google Cloud project,
# create an API key, and paste it here. Without it the app runs on fictional
# sample data and the daily scan is a no-op.
GOOGLE_PLACES_API_KEY=

# STRONGLY RECOMMENDED. Without a database, scanned leads live in memory and
# vanish when the serverless function restarts.
# Works with Neon, Supabase, Vercel Postgres, or any Postgres 13+ connection
# string. Use the *pooled* connection string on serverless hosts.
POSTGRES_URL=

# RECOMMENDED on a public deployment. Vercel Cron sends this as a bearer token
# so nobody else can trigger your daily scan and burn your Places quota.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. Set any value to put a password gate in front of the whole app.
# Leave blank and the deployment is publicly readable by anyone with the URL.
APP_PASSWORD=
