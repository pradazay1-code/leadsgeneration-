# ---------------------------------------------------------------------------
# LeadSignal configuration
#
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead.
#
# EVERYTHING HERE IS OPTIONAL. BizData + OpenStreetMap are free, keyless, and
# enabled by default, so scans work with zero configuration.
# ---------------------------------------------------------------------------

# STRONGLY RECOMMENDED. Without a database, scanned leads live in memory and
# vanish when the serverless function restarts. In Vercel: Storage → Create
# Database → Postgres, and this is injected automatically. Neon, Supabase, or
# any Postgres 13+ works — use the *pooled* connection string on serverless.
POSTGRES_URL=

# RECOMMENDED. Yelp Fusion API key — the main source of review counts (the
# best public "how new is this business" signal). business.yelp.com offers a
# 30-day trial with 5,000 calls, then it's pay-per-call.
YELP_API_KEY=

# OPTIONAL. Google Places API (New) key. The only source whose "no website on
# file" is definitive. Enable "Places API (New)" in Google Cloud first.
GOOGLE_PLACES_API_KEY=

# RECOMMENDED on a public deployment. Vercel Cron sends this as a bearer token
# so nobody else can trigger your daily scan. Generate: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. Set any value to put a password gate in front of the whole app.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Free-source tuning (rarely needed)
# ---------------------------------------------------------------------------
# Override the BizData endpoint (default https://bizdata-web.vercel.app).
BIZDATA_BASE_URL=
# Override the Overpass endpoint (default https://overpass-api.de/api/interpreter).
OVERPASS_URL=
# Set to 1 to disable a free source.
BIZDATA_DISABLED=
OSM_DISABLED=

# ---------------------------------------------------------------------------
# Geoapify (optional but useful)
# ---------------------------------------------------------------------------
# Does two jobs:
#  1. Powers the GEOCODER. OpenStreetMap's free geocoder (Nominatim) blocks
#     cloud hosts like Vercel, which silently disables every radius-based
#     search. A Geoapify key fixes that.
#  2. Adds a Geoapify Places source (OpenStreetMap-derived, so coverage of US
#     service businesses is OSM-level — pair it with Google Places for depth).
# Free tier: 3,000 requests/day. Get one at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Geoapify rejects unknown category names, so the app tries several candidates
# and ignores rejects. Override if you find better ones for your area
# (comma-separated, from Geoapify's category list).
GEOAPIFY_CATEGORIES_REAL_ESTATE=
GEOAPIFY_CATEGORIES_JUNK_REMOVAL=
