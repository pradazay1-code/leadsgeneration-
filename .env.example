# ---------------------------------------------------------------------------
# LeadSignal configuration
#
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead, then REDEPLOY — env vars
# only take effect on a new deployment.
# ---------------------------------------------------------------------------

# STRONGLY RECOMMENDED. Without a database, scanned leads live in memory and
# vanish when the serverless function restarts — and so do the API usage
# counters, which means the free-tier caps can't be enforced across requests.
# In Vercel: Storage → Create Database → Postgres, injected automatically.
# Neon, Supabase, or any Postgres 13+ works — use the *pooled* connection
# string on serverless.
POSTGRES_URL=

# ---------------------------------------------------------------------------
# Mapbox — the main discovery source
# ---------------------------------------------------------------------------
# Free-text POI search (Search Box API), which returns phone and website in the
# result metadata. Because Mapbox reports a website when it has one, "no
# website" from Mapbox is real evidence rather than a hole in the dataset —
# and that is the single heaviest scoring signal in this app.
#
# It also powers the GEOCODER, which every radius-based source depends on.
#
# Free tier: 25,000 search requests/month, 100,000 geocodes/month.
# Token: https://console.mapbox.com/account/access-tokens/
# A default public token (pk....) is fine; no scopes beyond the defaults.
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Brave Search — deep web research
# ---------------------------------------------------------------------------
# Two jobs, and the second is the more valuable one:
#  1. Finds businesses that no map dataset contains at all (small haulers with
#     a Facebook page and nothing else).
#  2. Confirms whether a business really has no website, as opposed to the map
#     source simply not knowing about one.
#
# Free tier is only 2,000 queries/month, so this runs LAST and on a tight cap.
# Key: https://api-dashboard.search.brave.com/app/keys (free "Data for Search"
# plan; a card is required at signup but the free tier is not charged).
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Supplementary sources — all optional
# ---------------------------------------------------------------------------
# Geoapify. Backup geocoder plus an OpenStreetMap-derived place source.
# Free tier: 3,000 credits/day. https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
# Geoapify rejects unknown category names, so the app tries several candidates
# and ignores rejects. Override if you find better ones (comma-separated).
GEOAPIFY_CATEGORIES_REAL_ESTATE=
GEOAPIFY_CATEGORIES_JUNK_REMOVAL=

# Yelp Fusion. Best supplier of review counts, but it BILLS PER CALL once the
# 30-day trial ends — so it ships DISABLED (cap 0). Setting a key is not enough
# to turn it on; you must also raise YELP_MONTHLY_CAP below, deliberately.
YELP_API_KEY=

# Free and keyless, on by default. Set either to 1 to disable.
BIZDATA_DISABLED=
OSM_DISABLED=
# Override the endpoints if you self-host them.
BIZDATA_BASE_URL=
OVERPASS_URL=

# ---------------------------------------------------------------------------
# Free-tier spend caps
# ---------------------------------------------------------------------------
# The app counts every outbound API call in Postgres and RESERVES budget before
# making the call, so parallel scans cannot collectively overshoot. When a cap
# is hit the source is skipped for the rest of the period — the scan continues
# with whatever else has budget, it does not fail.
#
# Defaults sit at roughly 80% of each vendor's free tier, leaving headroom for
# calls the vendor counts but this app doesn't see (retries, redirects).
# You only need these to make a budget TIGHTER, or to deliberately enable Yelp.
# Watch live usage under Settings → API usage.
#
# Defaults:                            free tier      cap here
MAPBOX_SEARCH_MONTHLY_CAP=           # 25,000/mo      20,000/mo
MAPBOX_SEARCH_DAILY_CAP=             # —                 800/day
MAPBOX_GEOCODE_MONTHLY_CAP=          # 100,000/mo     50,000/mo
BRAVE_MONTHLY_CAP=                   # 2,000/mo        1,500/mo
BRAVE_DAILY_CAP=                     # —                  60/day
GEOAPIFY_DAILY_CAP=                  # 3,000/day       2,000/day
OVERPASS_DAILY_CAP=                  # be polite         200/day
# Yelp is OFF unless you raise these. It is pay-per-call after the trial.
YELP_MONTHLY_CAP=                    # trial only            0
YELP_DAILY_CAP=                      #                      0

# ---------------------------------------------------------------------------
# Access and scheduling
# ---------------------------------------------------------------------------
# RECOMMENDED on a public deployment. Vercel Cron sends this as a bearer token
# so nobody else can trigger your daily scan. Generate: openssl rand -hex 32
CRON_SECRET=

# OPTIONAL. Set any value to put a password gate in front of the whole app.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Outreach sending — all optional
# ---------------------------------------------------------------------------
# Without these, sequence email/SMS steps become TASKS with the message
# pre-written, so nothing is lost — you just send them yourself.

# Email via Resend (https://resend.com). Requires a verified sending domain.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
# Optional: where replies should go, if different from the From address.
OUTREACH_REPLY_TO=

# SMS via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Guardrails. Automated sends only go out Mon-Sat, 8am-7pm in this timezone
# (hours from UTC; -5 = US Eastern, -8 = Pacific). Outside that window steps
# defer to the next run rather than sending.
OUTREACH_TIMEZONE_OFFSET=-5
# Max automated sends per run, so a misconfigured cadence can't blast a town.
OUTREACH_DAILY_CAP=50
# Set to 1 ONLY for testing — bypasses the business-hours guard.
OUTREACH_IGNORE_HOURS=
